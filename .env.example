# Required — GitHub token with permission to read issues and write labels/comments
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Required — key for your OpenAI-compatible LLM endpoint
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional — defaults shown
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional — used when no owner/repo argument is passed (set automatically in GitHub Actions)
# GITHUB_REPOSITORY=owner/repo
